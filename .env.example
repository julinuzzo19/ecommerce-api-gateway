# ==================================
# API GATEWAY - CONFIGURACIÓN
# ==================================

# Puerto en el que correrá el API Gateway
PORT=3000

# Entorno de ejecución (development, production)
NODE_ENV=development

# ==================================
# MICROSERVICIOS
# ==================================

# URL del servicio de autenticación
AUTH_SERVICE_URL=http://localhost:3001

# URL del servicio de ecommerce
ECOMMERCE_SERVICE_URL=http://localhost:3002

# URL del servicio de inventario
INVENTORY_SERVICE_URL=http://localhost:3003

# ==================================
# USERS (SERVERLESS)
# ==================================

# (Recomendado si desplegaste un HTTP API con endpoints /users/*)
# Si seteás esta variable, el gateway proxya /users hacia tu API Gateway (execute-api)
USERS_HTTP_API_BASE_URL=https://gb4f1nlzc4.execute-api.us-east-1.amazonaws.com

# (DEV) serverless-offline para Users.
# IMPORTANTE: este puerto NO puede ser el mismo que el del gateway.
# Ejemplo: gateway en 3000 y serverless-offline en 4000.
# Si seteás esta variable, el gateway invoca las funciones locales vía /2015-03-31/functions/<fn>/invocations
USERS_SERVERLESS_OFFLINE_URL=http://localhost:4000

# (Opcional) mapping de nombres de funciones (si en serverless.yml difieren)
USERS_FN_CREATE_USER=createUser
USERS_FN_GET_USER_BY_ID=getUserById
USERS_FN_GET_USER_BY_EMAIL=getUserByEmail
USERS_FN_LIST_USERS=listUsers
USERS_FN_UPDATE_USER=updateUser

# (Opcional) URL legacy del servicio users por HTTP si aún lo estás usando.
# USER_SERVICE_URL=http://localhost:3004

# ==================================
# SEGURIDAD
# ==================================

# Secreto compartido entre el gateway y los microservicios
# Los microservicios deben validar este header para asegurar que la petición viene del gateway
GATEWAY_SECRET=tu_secreto_super_seguro_aqui

# Secreto para firmar/validar JWT (debe ser el mismo que usa el servicio de autenticación)
JWT_SECRET=tu_jwt_secret_super_seguro_aqui

# ==================================
# RATE LIMITING
# ==================================

# Ventana de tiempo para rate limiting (en milisegundos)
# 900000 = 15 minutos
RATE_LIMIT_WINDOW_MS=900000

# Máximo de peticiones por IP en la ventana de tiempo
RATE_LIMIT_MAX_REQUESTS=100

# ==================================
# CORS
# ==================================

# Orígenes permitidos para CORS (separados por coma)
# En desarrollo puedes usar * o dejar http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================================
# LOGGING
# ==================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Observability
SERVICE_NAME=gateway-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

IN_DOCKER=true